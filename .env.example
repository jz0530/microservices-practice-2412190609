# Copy to .env and replace every example password/token before starting.
MYSQL_ROOT_PASSWORD=replace-with-your-root-password
MYSQL_DATABASE=campus_trade
MYSQL_USER=campus_trade
MYSQL_PASSWORD=replace-with-your-app-password
APP_PORT=8084

# Week06: replace all six values with separate local passwords.
USER_PORT=8101
USER_DB_PASSWORD=replace-user-password
USER_DB_ROOT_PASSWORD=replace-user-root-password
PRODUCT_PORT=8102
PRODUCT_DB_PASSWORD=replace-product-password
PRODUCT_DB_ROOT_PASSWORD=replace-product-root-password
ORDER_PORT=8103
ORDER_DB_PASSWORD=replace-order-password
ORDER_DB_ROOT_PASSWORD=replace-order-root-password

# Week07 Nacos: keep these only in local .env.
NACOS_PASSWORD=replace-nacos-admin-password
# Generate with: openssl rand -base64 32
NACOS_AUTH_TOKEN=replace-with-openssl-rand-base64-32
NACOS_AUTH_IDENTITY_KEY=replace-nacos-identity-key
NACOS_AUTH_IDENTITY_VALUE=replace-nacos-identity-value
